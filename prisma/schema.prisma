//////////////////////////////////////
// PRISMA CONFIG
//////////////////////////////////////

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////
// ENUMS
//////////////////////////////////////

enum JourneyState {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum Rating {
  ALWAYS
  OFTEN
  RARELY
  NEVER
}

enum IrrationalBelief {
  MUST_BE_LOVED
  MUST_BE_COMPETENT
  MUST_HAVE_COMFORT
}

enum LacunaCategory {
  A
  B
  C
}

enum GovernanceStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum ChallengeStatus {
  APPLIED
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VratmitraStatus {
  PENDING
  ACTIVE
  DETACHED
}

//////////////////////////////////////
// CORE USER & ROLES
//////////////////////////////////////

model User {
  id           String   @id @default(uuid())
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())

  shortlistSessions LacunaShortlistSession[]
  assessments       LacunaAssessment[]
  journeys          SentenceJourney[]
  vratmitraLinks    JourneyVratmitra[]

  adminRole         AdminRole?
}

model AdminRole {
  userId     String   @id
  grantedAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}

//////////////////////////////////////
// ONTOLOGY (STATIC)
//////////////////////////////////////

model Lacuna {
  id       String         @id @default(uuid())
  nameEn   String         @unique
  nameMr   String
  category LacunaCategory

  assessments          LacunaAssessment[]
  lacunaShortlistItems LacunaShortlistItem[]
  lacunaSubVirtues     LacunaSubVirtue[]

  @@index([category])
}

model Virtue {
  id        String     @id @default(uuid())
  nameEn    String     @unique
  nameMr    String

  subVirtues SubVirtue[]
}

model SubVirtue {
  id        String   @id @default(uuid())
  nameEn    String   @unique
  nameMr    String

  virtueId  String
  virtue    Virtue   @relation(fields: [virtueId], references: [id])

  sentences Sentence[]
  lacunaSubVirtues LacunaSubVirtue[]
}

model LacunaSubVirtue {
  id          String   @id @default(uuid())
  lacunaId    String
  subVirtueId String
  priority    Int

  lacuna    Lacuna    @relation(fields: [lacunaId], references: [id])
  subVirtue SubVirtue @relation(fields: [subVirtueId], references: [id])

  @@unique([lacunaId, subVirtueId])
}

model Sentence {
  id          String   @id @default(uuid())
  textEn      String   @unique
  textMr      String

  subVirtueId String
  subVirtue   SubVirtue @relation(fields: [subVirtueId], references: [id])

  assessmentResponses AssessmentResponse[]
  suggestedSnapshots  SuggestedSentenceSnapshot[]
  journeys             SentenceJourney[]

  communityExposures   CommunityExposure[]
  communityResolutions CommunityResolution[]
  communityChallenges  CommunityChallenge[]
}

//////////////////////////////////////
// LACUNA SHORTLISTING
//////////////////////////////////////

model LacunaShortlistSession {
  id        String   @id @default(uuid())
  userId    String
  note      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  items     LacunaShortlistItem[]
  lacunaAssessments LacunaAssessment[]
}

model LacunaShortlistItem {
  id         String @id @default(uuid())
  sessionId  String
  lacunaId   String
  rank       Int

  session LacunaShortlistSession @relation(fields: [sessionId], references: [id])
  lacuna  Lacuna                 @relation(fields: [lacunaId], references: [id])

  @@unique([sessionId, lacunaId])
}

//////////////////////////////////////
// LACUNA ASSESSMENTS
//////////////////////////////////////

model LacunaAssessment {
  id          String           @id @default(uuid())
  userId      String
  lacunaId    String
  status      AssessmentStatus
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  shortlistSessionId String?
  shortlistSession   LacunaShortlistSession? @relation(fields: [shortlistSessionId], references: [id])

  user        User   @relation(fields: [userId], references: [id])
  lacuna      Lacuna @relation(fields: [lacunaId], references: [id])

  responses   AssessmentResponse[]
  suggestions SuggestedSentenceSnapshot[]
  links       SentenceJourneyAssessmentLink[]
}

model AssessmentResponse {
  id           String @id @default(uuid())
  assessmentId String
  sentenceId   String
  rating       Rating
  answeredAt   DateTime @default(now())

  assessment LacunaAssessment @relation(fields: [assessmentId], references: [id])
  sentence   Sentence         @relation(fields: [sentenceId], references: [id])

  @@unique([assessmentId, sentenceId])
}

model SuggestedSentenceSnapshot {
  id           String @id @default(uuid())
  assessmentId String
  sentenceId   String
  priorityRank Int
  reason       String

  assessment LacunaAssessment @relation(fields: [assessmentId], references: [id])
  sentence   Sentence         @relation(fields: [sentenceId], references: [id])

  @@unique([assessmentId, sentenceId])
}

//////////////////////////////////////
// SENTENCE JOURNEY (CORE)
//////////////////////////////////////

model SentenceJourney {
  id             String        @id @default(uuid())
  userId         String
  sentenceId     String
  state          JourneyState
  createdAt      DateTime      @default(now())
  inactiveAt     DateTime?
  inactiveReason String?

  user     User     @relation(fields: [userId], references: [id])
  sentence Sentence @relation(fields: [sentenceId], references: [id])

  links       SentenceJourneyAssessmentLink[]
  resolutions ResolutionInstance[]
  reflections DailyReflection[]
  exposures   ExposureInstance[]
  challenges  ChallengeInstance[]
  vratmitras  JourneyVratmitra[]

  @@unique([userId, sentenceId])
}

model SentenceJourneyAssessmentLink {
  id                  String @id @default(uuid())
  journeyId           String
  assessmentId        String

  virtueRelationNote  String?
  lacunaReductionNote String
  unifiedInsightNote  String
  personalContextNote String
  irrationalBelief    IrrationalBelief

  createdAt DateTime @default(now())

  journey    SentenceJourney  @relation(fields: [journeyId], references: [id])
  assessment LacunaAssessment @relation(fields: [assessmentId], references: [id])

  @@unique([journeyId, assessmentId])
}

//////////////////////////////////////
// VRATMITRA ATTACHMENT
//////////////////////////////////////

model JourneyVratmitra {
  id         String         @id @default(uuid())
  journeyId  String
  userId     String
  status     VratmitraStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  acceptedAt DateTime?
  detachedAt DateTime?

  journey SentenceJourney @relation(fields: [journeyId], references: [id])
  user    User            @relation(fields: [userId], references: [id])

  @@unique([journeyId, userId])
}

//////////////////////////////////////
// EXPOSURES
//////////////////////////////////////

model ExposureInstance {
  id          String   @id @default(uuid())
  journeyId   String
  description String
  contextNote String?
  createdAt   DateTime @default(now())

  journey SentenceJourney @relation(fields: [journeyId], references: [id])
}

model CommunityExposure {
  id         String           @id @default(uuid())
  sentenceId String
  description String
  governance GovernanceStatus
  createdAt  DateTime @default(now())

  sentence Sentence @relation(fields: [sentenceId], references: [id])

  exposureRecommendations ExposureRecommendation[]
}

model ExposureRecommendation {
  id            String   @id @default(uuid())
  exposureId    String
  journeyId     String
  recommendedBy String
  createdAt     DateTime @default(now())

  exposure CommunityExposure @relation(fields: [exposureId], references: [id])
}

//////////////////////////////////////
// RESOLUTIONS
//////////////////////////////////////

model ResolutionInstance {
  id        String   @id @default(uuid())
  journeyId String
  text      String
  frequency String
  createdAt DateTime @default(now())

  journey SentenceJourney @relation(fields: [journeyId], references: [id])
}

model CommunityResolution {
  id         String           @id @default(uuid())
  sentenceId String
  text       String
  governance GovernanceStatus
  createdAt  DateTime @default(now())

  sentence Sentence @relation(fields: [sentenceId], references: [id])

  resolutionRecommendations ResolutionRecommendation[]
}

model ResolutionRecommendation {
  id              String   @id @default(uuid())
  resolutionId    String
  journeyId       String
  recommendedBy   String
  createdAt       DateTime @default(now())

  resolution CommunityResolution @relation(fields: [resolutionId], references: [id])
}

//////////////////////////////////////
// CHALLENGES
//////////////////////////////////////

model ChallengeInstance {
  id              String           @id @default(uuid())
  journeyId       String
  status          ChallengeStatus
  applicationNote String?
  approvalNote    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  journey SentenceJourney @relation(fields: [journeyId], references: [id])
}

model CommunityChallenge {
  id         String           @id @default(uuid())
  sentenceId String
  description String
  governance GovernanceStatus
  createdAt  DateTime @default(now())

  sentence Sentence @relation(fields: [sentenceId], references: [id])
}

//////////////////////////////////////
// DAILY REFLECTIONS
//////////////////////////////////////

model DailyReflection {
  id          String   @id @default(uuid())
  journeyId   String
  date        DateTime
  applied     Boolean
  contextNote String?
  insightNote String?
  difficulty  Int?
  createdAt   DateTime @default(now())

  journey SentenceJourney @relation(fields: [journeyId], references: [id])

  @@unique([journeyId, date])
}
